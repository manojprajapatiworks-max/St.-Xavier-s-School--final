{
  "entities": {
    "SchoolInfo": {
      "title": "School Information",
      "description": "General information about the school, editable by admin.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImageUrl": { "type": "string", "format": "uri" },
        "faculty": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "imageUrl": { "type": "string", "format": "uri" }
            }
          }
        },
        "facilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "imageUrl": { "type": "string", "format": "uri" }
            }
          }
        }
      },
      "required": ["name"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "School-wide announcements.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["title", "content", "date"]
    },
    "Student": {
      "title": "Student",
      "description": "Student details and portal access data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "portalCode": { "type": "string", "description": "Unique code for parent portal access" },
        "class": { "type": "string" },
        "rollNumber": { "type": "string" },
        "parentName": { "type": "string" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": { "type": "string" },
              "score": { "type": "number" },
              "total": { "type": "number" },
              "term": { "type": "string" }
            }
          }
        },
        "attendance": { "type": "number", "description": "Percentage" }
      },
      "required": ["name", "portalCode"]
    },
    "ClassWork": {
      "title": "Class Work",
      "description": "Daily class work and homework details.",
      "type": "object",
      "properties": {
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["className", "subject", "date"]
    },
    "Document": {
      "title": "School Document",
      "description": "Downloadable documents like Profarma, forms, etc.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "type": { "type": "string", "enum": ["profarma", "form", "result", "report"] },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "url", "type"]
    },
    "JobPosting": {
      "title": "Job Posting",
      "description": "Career opportunities at the school.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "department": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "postedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["open", "closed"] }
      },
      "required": ["title", "department", "postedAt", "status"]
    },
    "ActionLog": {
      "title": "Action Log",
      "description": "Audit trail of user actions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["admin", "teacher"] },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" }
      },
      "required": ["userId", "userName", "userRole", "action", "target", "timestamp"]
    }
  },
  "firestore": {
    "/school/info": {
      "schema": "SchoolInfo",
      "description": "Singleton document for school settings."
    },
    "/announcements/{id}": {
      "schema": "Announcement",
      "description": "Collection of school announcements."
    },
    "/students/{id}": {
      "schema": "Student",
      "description": "Collection of student records."
    },
    "/classwork/{id}": {
      "schema": "ClassWork",
      "description": "Collection of class work entries."
    },
    "/documents/{id}": {
      "schema": "Document",
      "description": "Collection of downloadable school documents."
    },
    "/jobs/{id}": {
      "schema": "JobPosting",
      "description": "Collection of job postings."
    },
    "/logs/{id}": {
      "schema": "ActionLog",
      "description": "Collection of system action logs."
    }
  }
}
