rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: school
    // Document ID: info (Singleton)
    // Fields: name, logoUrl, heroTitle, heroSubtitle, heroImages, faculty, facilities, footer
    //
    // Collection: announcements
    // Document ID: auto-generated
    // Fields: title, content, date, priority
    //
    // Collection: students
    // Document ID: portalCode (Unique code for parent portal access)
    // Fields: name, portalCode, class, rollNumber, parentName, results, attendance, imageUrl, lastEditedBy, lastEditedAt
    //
    // Collection: classwork
    // Document ID: auto-generated
    // Fields: className, subject, topic, description, date
    //
    // Collection: documents
    // Document ID: auto-generated
    // Fields: title, url, type, uploadedAt
    //
    // Collection: teachers
    // Document ID: auto-generated
    // Fields: name, email, subject
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "manojprajapatiworks@gmail.com" && request.auth.token.email_verified == true);
    }

    function isTeacher() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }
    
    // Alternative teacher check if we don't use email as ID
    function isTeacherByEmail() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    // Since we use auto-generated IDs for teachers, we need a query or a specific path.
    // Let's assume for rules simplicity we might want to check a 'teachers' collection.
    // A better way is to have a 'users' collection with roles, but I'll stick to the requested teacher list.
    
    function isTeacherInList() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/teachers_meta/emails).data.list.hasAny([request.auth.token.email]);
    }
    
    // For now, I'll allow teachers based on a simple check or just admin for sensitive parts.
    // Actually, I'll update the logic to check the 'teachers' collection by querying if needed, 
    // but Firestore rules can't easily query. 
    // I'll use a specific document for teacher emails for fast lookup.
    
    function isAuthorizedTeacher() {
       // This is a placeholder. In a real app, you'd use custom claims or a dedicated roles doc.
       // For this app, I'll allow if the email exists in the 'teachers' collection.
       // Note: get() counts as a read.
       return isAuthenticated() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // School Info
    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documents
    match /documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Students
    match /students/{portalCode} {
      allow get: if true; 
      allow list: if isAdmin() || isAuthorizedTeacher();
      allow create: if isAdmin();
      allow update: if isAdmin() || isAuthorizedTeacher();
      allow delete: if isAdmin();
    }

    // Class Work
    match /classwork/{id} {
      allow read: if true;
      allow write: if isAdmin() || isAuthorizedTeacher();
    }

    // Teachers
    match /teachers/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
