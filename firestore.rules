rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: school
    // Document ID: info (Singleton)
    // Fields: name, logoUrl, heroTitle, heroSubtitle, heroImageUrl, faculty, facilities
    //
    // Collection: announcements
    // Document ID: auto-generated
    // Fields: title, content, date, priority
    //
    // Collection: students
    // Document ID: portalCode (Unique code for parent portal access)
    // Fields: name, portalCode, class, rollNumber, parentName, results, attendance
    //
    // Collection: classwork
    // Document ID: auto-generated
    // Fields: className, subject, topic, description, date
    //
    // Collection: documents
    // Document ID: auto-generated
    // Fields: title, url, type, uploadedAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "manojprajapatiworks@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // School Info
    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documents
    match /documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Students
    // Parents can only 'get' their child's data if they know the portalCode (which is the doc ID)
    match /students/{portalCode} {
      allow get: if true; // Knowledge of the unique portalCode grants access to 'get'
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Class Work
    match /classwork/{id} {
      allow read: if true; // Publicly readable for parents to check class work
      allow write: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
