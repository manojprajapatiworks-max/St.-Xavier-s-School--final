rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: school
    // Document ID: info (Singleton)
    // Fields: name, logoUrl, heroTitle, heroSubtitle, heroImages, faculty, facilities, footer
    //
    // Collection: announcements
    // Document ID: auto-generated
    // Fields: title, content, date, priority
    //
    // Collection: students
    // Document ID: portalCode (Unique code for parent portal access)
    // Fields: name, portalCode, class, rollNumber, parentName, results, attendance, imageUrl, lastEditedBy, lastEditedAt
    //
    // Collection: classwork
    // Document ID: auto-generated
    // Fields: className, subject, topic, description, date
    //
    // Collection: documents
    // Document ID: auto-generated
    // Fields: title, url, type, uploadedAt
    //
    // Collection: teachers
    // Document ID: auto-generated
    // Fields: name, email, subject
    //
    // Collection: jobs
    // Document ID: auto-generated
    // Fields: title, department, description, requirements, postedAt, status
    //
    // Collection: logs
    // Document ID: auto-generated
    // Fields: userId, userName, userRole, action, target, timestamp, details
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        'email' in request.auth.token &&
        request.auth.token.email.lower() == "manojprajapatiworks@gmail.com";
    }

    function isAuthorizedTeacher() {
       return isAuthenticated() && 
              'email' in request.auth.token &&
              exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower()));
    }

    function hasTeacherPrivilege(privilege) {
      return isAuthorizedTeacher() && 
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower())).data.get('privileges', {})[privilege] == true;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // School Info
    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documents
    match /documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Students
    match /students/{portalCode} {
      allow get: if true; 
      allow list: if isAdmin() || isAuthorizedTeacher();
      allow create: if isAdmin() || hasTeacherPrivilege('students');
      allow update: if isAdmin() || 
                    hasTeacherPrivilege('students') || 
                    (hasTeacherPrivilege('results') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['results', 'lastEditedBy', 'lastEditedAt']));
      allow delete: if isAdmin();
    }

    // Class Work
    match /classwork/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasTeacherPrivilege('classwork');
    }

    // Teachers
    match /teachers/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Jobs
    match /jobs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hall of Fame
    match /hall_of_fame/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Logs
    match /logs/{id} {
      allow list: if isAdmin() || (
        isAuthenticated() && 
        (
          ('email' in request.auth.token && resource.data.userId.lower() == request.auth.token.email.lower()) ||
          (resource.data.userId == request.auth.uid)
        )
      );
      allow get: if isAdmin() || (
        isAuthenticated() && 
        (
          ('email' in request.auth.token && resource.data.userId.lower() == request.auth.token.email.lower()) ||
          (resource.data.userId == request.auth.uid)
        )
      );
      allow create: if isAdmin() || (
        isAuthenticated() && 
        (
          ('email' in request.auth.token && request.resource.data.userId.lower() == request.auth.token.email.lower()) ||
          (request.resource.data.userId == request.auth.uid)
        )
      );
      allow update, delete: if false;
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
